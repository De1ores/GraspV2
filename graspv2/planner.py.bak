"""Collision-checked arm planning driven exclusively by the official IK SDK."""

from __future__ import annotations

from bisect import bisect_right
from dataclasses import dataclass
import json
import math
from pathlib import Path
import threading
import time
from typing import Iterable

import numpy as np

from .official_ik import OfficialIK, WorldIKResult
from .robot_profiles import (
    AVAILABLE_GRIPPER_SIDES,
    INSTALLED_GRIPPER_SIDE,
    RobotProfile,
)
from .simulation import (
    CollisionReport,
    OMNIPICKER_MAX_GRASP_DIAMETER_M,
    RobotSimulation,
    TableObstacle,
    load_table_obstacle,
    resolve_robot_visual_urdf,
    validate_fk_alignment,
)


SIDE_GRASP_APPROACH_HEADING_DEG = 0.0
MAXIMUM_GRIPPER_AXIS_ERROR_DEG = 1.0
GRIPPER_PREOPEN_DURATION_S = 2.0
GRIPPER_CLOSE_DURATION_S = 2.0
GRASP_SETTLE_DURATION_S = 0.3
GRIPPER_RELEASE_DURATION_S = 2.0
OBJECT_DROP_DURATION_S = 0.7
GRIPPER_RECLOSE_DURATION_S = 2.0


def _rotation_matrix_to_rpy(rotation: np.ndarray) -> tuple[float, float, float]:
    """Convert Rz(yaw) Ry(pitch) Rx(roll) to fixed-axis roll/pitch/yaw."""

    cosine_pitch = math.hypot(float(rotation[0, 0]), float(rotation[1, 0]))
    pitch = math.atan2(-float(rotation[2, 0]), cosine_pitch)
    if cosine_pitch < 1e-9:
        yaw = 0.0
        roll = (
            math.atan2(float(rotation[0, 1]), float(rotation[1, 1]))
            if pitch > 0.0
            else math.atan2(-float(rotation[0, 1]), float(rotation[1, 1]))
        )
    else:
        roll = math.atan2(float(rotation[2, 1]), float(rotation[2, 2]))
        yaw = math.atan2(float(rotation[1, 0]), float(rotation[0, 0]))
    return roll, pitch, yaw


@dataclass
class TreeNode:
    joints: np.ndarray
    parent: int | None


@dataclass(frozen=True)
class PlannedTrajectory:
    profile: RobotProfile
    side: str
    obstacle: TableObstacle | None
    visual_urdf_path: Path | None
    target_world_xyz: tuple[float, float, float]
    pregrasp_world_xyz: tuple[float, float, float]
    joint_names: tuple[str, ...]
    times: tuple[float, ...]
    positions: tuple[tuple[float, ...], ...]
    report: dict[str, object]

    @property
    def duration_s(self) -> float:
        return self.times[-1]

    def document(self) -> dict[str, object]:
        frames = []
        for index, (time_s, positions) in enumerate(zip(self.times, self.positions)):
            frames.append(
                {
                    "frame": index,
                    "time_s": time_s,
                    "active_joints_rad": dict(zip(self.joint_names, positions)),
                }
            )
        return {
            "format": "x2_active_joint_trajectory",
            "format_version": 1,
            "units": {"time": "s", "joint_angle": "rad"},
            "robot_profile": self.profile.name,
            "arm_side": self.side,
            "active_joint_names": list(self.joint_names),
            "frame_count": len(frames),
            "duration_s": self.duration_s,
            "frames": frames,
            "planning": self.report,
        }

    def write(self, trajectory_path: Path, report_path: Path) -> None:
        trajectory_path.parent.mkdir(parents=True, exist_ok=True)
        report_path.parent.mkdir(parents=True, exist_ok=True)
        trajectory_path.write_text(
            json.dumps(self.document(), ensure_ascii=False, indent=2) + "\n",
            encoding="utf-8",
        )
        report_path.write_text(
            json.dumps(self.report, ensure_ascii=False, indent=2) + "\n",
            encoding="utf-8",
        )


@dataclass(frozen=True)
class SimulatedGraspSequence:
    """Collision-checked arm paths plus deterministic gripper/object phases."""

    approach: PlannedTrajectory
    lift: PlannedTrajectory
    return_to_default: PlannedTrajectory
    visual_radius_m: float
    preopen_position: float
    grip_position: float
    report: dict[str, object]
    open_duration_s: float = GRIPPER_PREOPEN_DURATION_S
    close_duration_s: float = GRIPPER_CLOSE_DURATION_S
    grasp_settle_duration_s: float = GRASP_SETTLE_DURATION_S
    release_duration_s: float = GRIPPER_RELEASE_DURATION_S
    object_drop_duration_s: float = OBJECT_DROP_DURATION_S
    reclose_duration_s: float = GRIPPER_RECLOSE_DURATION_S

    @property
    def duration_s(self) -> float:
        return (
            self.approach.duration_s
            + self.open_duration_s
            + self.close_duration_s
            + self.grasp_settle_duration_s
            + self.lift.duration_s
            + self.release_duration_s
            + self.object_drop_duration_s
            + self.reclose_duration_s
            + self.return_to_default.duration_s
        )


def gripper_positions_for_visual_radius(
    visual_radius_m: float,
    *,
    maximum_diameter_m: float = OMNIPICKER_MAX_GRASP_DIAMETER_M,
    opening_clearance_m: float = 0.012,
    grip_compression_m: float = 0.004,
) -> tuple[float, float]:
    """Map an apparent object radius to normalized OmniPicker openings."""

    radius = float(visual_radius_m)
    maximum = float(maximum_diameter_m)
    if not math.isfinite(radius) or radius <= 0.0:
        raise ValueError("visual_radius_m must be positive and finite")
    if not math.isfinite(maximum) or maximum <= 0.0:
        raise ValueError("maximum_diameter_m must be positive and finite")
    diameter = 2.0 * radius
    preopen = min(1.0, max(0.0, (diameter + opening_clearance_m) / maximum))
    grip = min(1.0, max(0.0, (diameter - grip_compression_m) / maximum))
    return preopen, min(grip, preopen)


class CollisionChecker:
    """State and edge validation over one active arm."""

    def __init__(
        self,
        simulation: RobotSimulation,
        side: str,
        base_arm_pos: Iterable[float],
        clearance_m: float,
        edge_resolution_rad: float,
    ):
        self.simulation = simulation
        self.side = side
        self.base_arm_pos = tuple(float(value) for value in base_arm_pos)
        self.clearance_m = float(clearance_m)
        self.edge_resolution_rad = float(edge_resolution_rad)
        self.state_checks = 0
        self.minimum_table_distance_m = simulation.probe_distance_m
        self.nearest_table_body: str | None = None
        self.last_invalid_report: CollisionReport | None = None

    def arm_pos_for(self, joints: Iterable[float]) -> list[float]:
        arm_pos = list(self.base_arm_pos)
        values = list(float(value) for value in joints)
        offset = 0 if self.side == "left" else self.simulation.profile.arm_dof
        arm_pos[offset:offset + self.simulation.profile.arm_dof] = values
        return arm_pos

    def state_report(self, joints: Iterable[float]) -> CollisionReport:
        self.state_checks += 1
        self.simulation.set_arm_pos(self.arm_pos_for(joints))
        report = self.simulation.collision_report(self.clearance_m)
        if report.minimum_table_distance_m < self.minimum_table_distance_m:
            self.minimum_table_distance_m = report.minimum_table_distance_m
            self.nearest_table_body = report.nearest_table_body
        if not report.valid:
            self.last_invalid_report = report
        return report

    def state_valid(self, joints: Iterable[float]) -> bool:
        return self.state_report(joints).valid

    def edge_valid(self, start: Iterable[float], goal: Iterable[float]) -> bool:
        start_values = np.asarray(tuple(start), dtype=float)
        goal_values = np.asarray(tuple(goal), dtype=float)
        delta = goal_values - start_values
        samples = max(
            1,
            int(
                math.ceil(
                    float(np.max(np.abs(delta))) / self.edge_resolution_rad
                )
            ),
        )
        return all(
            self.state_valid(start_values + phase * delta)
            for phase in np.linspace(0.0, 1.0, samples + 1)
        )


def _reconstruct(nodes: list[TreeNode], index: int) -> list[np.ndarray]:
    result = []
    while index is not None:
        node = nodes[index]
        result.append(node.joints.copy())
        index = node.parent
    result.reverse()
    return result


def plan_rrt(
    start: np.ndarray,
    goal: np.ndarray,
    checker: CollisionChecker,
    lower: np.ndarray,
    upper: np.ndarray,
    rng: np.random.Generator,
    *,
    step_size_rad: float = 0.24,
    maximum_iterations: int = 2500,
    goal_bias: float = 0.22,
) -> tuple[list[np.ndarray], dict[str, object]]:
    """Deterministic goal-biased RRT with collision checks on every edge."""
    if not checker.state_valid(start):
        raise RuntimeError(f"start pose is in collision: {checker.last_invalid_report}")
    if not checker.state_valid(goal):
        raise RuntimeError(f"pregrasp pose is in collision: {checker.last_invalid_report}")
    if checker.edge_valid(start, goal):
        return [start.copy(), goal.copy()], {
            "direct_path": True,
            "iterations": 0,
            "nodes": 2,
        }

    scale = upper - lower
    nodes = [TreeNode(start.copy(), None)]
    for iteration in range(1, maximum_iterations + 1):
        sample = goal if rng.random() < goal_bias else rng.uniform(lower, upper)
        nearest_index = min(
            range(len(nodes)),
            key=lambda candidate: float(
                np.linalg.norm((nodes[candidate].joints - sample) / scale)
            ),
        )
        nearest = nodes[nearest_index].joints
        delta = sample - nearest
        distance = float(np.linalg.norm(delta))
        candidate = (
            sample.copy()
            if distance <= step_size_rad
            else nearest + delta * (step_size_rad / distance)
        )
        if not checker.edge_valid(nearest, candidate):
            continue
        nodes.append(TreeNode(candidate, nearest_index))
        new_index = len(nodes) - 1
        if checker.edge_valid(candidate, goal):
            nodes.append(TreeNode(goal.copy(), new_index))
            return _reconstruct(nodes, len(nodes) - 1), {
                "direct_path": False,
                "iterations": iteration,
                "nodes": len(nodes),
            }
    raise RuntimeError(
        f"RRT failed after {maximum_iterations} iterations and {len(nodes)} nodes"
    )


def shortcut_path(
    path: list[np.ndarray],
    checker: CollisionChecker,
    rng: np.random.Generator,
    attempts: int = 120,
) -> list[np.ndarray]:
    result = [point.copy() for point in path]
    for _ in range(attempts):
        if len(result) <= 2:
            break
        first, second = sorted(rng.choice(len(result), size=2, replace=False))
        if second <= first + 1:
            continue
        if checker.edge_valid(result[first], result[second]):
            result[first + 1:second] = []
    return result


def _random_arm_seed(
    ik: OfficialIK,
    side: str,
    base_arm_pos: list[float],
    rng: np.random.Generator,
) -> list[float]:
    lower, upper = ik.joint_limits_for_side(side)
    result = list(base_arm_pos)
    offset = 0 if side == "left" else ik.profile.arm_dof
    result[offset:offset + ik.profile.arm_dof] = rng.uniform(lower, upper)
    return result


def solve_collision_free_ik(
    ik: OfficialIK,
    checker: CollisionChecker,
    side: str,
    target_world_xyz: Iterable[float],
    preferred_arm_pos: list[float],
    rng: np.random.Generator,
    *,
    attempts: int = 14,
    required_edge_start: np.ndarray | None = None,
    target_axis_world: Iterable[float] | None = None,
    target_rpy_world: Iterable[float] | None = None,
) -> WorldIKResult:
    """Try official IK from deterministic seeds and reject colliding results."""
    last_result: WorldIKResult | None = None
    target = tuple(float(value) for value in target_world_xyz)
    ik_solution_count = 0
    for attempt in range(attempts):
        seed = (
            preferred_arm_pos
            if attempt == 0
            else _random_arm_seed(ik, side, preferred_arm_pos, rng)
        )
        if target_axis_world is None and target_rpy_world is None:
            result = ik.solve_world_position(side, target, seed)
        else:
            position_seed = ik.solve_world_position(side, target, seed)
            pose_seed = position_seed.arm_pos if position_seed.success else seed
            if target_axis_world is not None:
                axis_result = ik.solve_world_position_axis(
                    side,
                    target,
                    target_axis_world,
                    pose_seed,
                )
                pose_seed = axis_result.arm_pos
            result = (
                ik.solve_world_pose(
                    side,
                    target,
                    target_rpy_world,
                    pose_seed,
                )
                if target_rpy_world is not None
                else axis_result
            )
        last_result = result
        if not result.success:
            continue
        ik_solution_count += 1
        active = np.asarray(result.active_arm, dtype=float)
        if not checker.state_valid(active):
            continue
        if required_edge_start is not None and not checker.edge_valid(
            required_edge_start, active
        ):
            continue
        return result
    suffix = ""
    if last_result is not None:
        suffix = (
            f"; final SDK error={last_result.sdk_result.error_norm:.6g}, "
            f"message={last_result.sdk_result.message}"
        )
    target_text = "[" + ", ".join(f"{value:.6f}" for value in target) + "]"
    if ik_solution_count == 0:
        raise RuntimeError(
            f"official IK found no solution for {side} target_world_m={target_text} "
            f"after {attempts} attempts{suffix}"
        )
    raise RuntimeError(
        f"official IK solutions for {side} target_world_m={target_text} were rejected "
        f"by collision/edge checks after {attempts} attempts{suffix}"
    )


def _minimum_jerk(ratio: float) -> float:
    return ratio**3 * (10.0 + ratio * (-15.0 + 6.0 * ratio))


def sample_waypoints(
    waypoints: list[np.ndarray],
    maximum_velocity_rad_s: float,
    *,
    rate_hz: float = 50.0,
) -> tuple[tuple[float, ...], tuple[tuple[float, ...], ...]]:
    if len(waypoints) < 2:
        raise ValueError("at least two waypoints are required")
    times = [0.0]
    positions = [tuple(float(value) for value in waypoints[0])]
    elapsed = 0.0
    for start, goal in zip(waypoints, waypoints[1:]):
        delta = goal - start
        # The peak derivative of minimum-jerk is 1.875 times displacement/duration.
        duration = max(
            0.24,
            1.875 * float(np.max(np.abs(delta))) / maximum_velocity_rad_s,
        )
        samples = max(2, int(math.ceil(duration * rate_hz)))
        duration = samples / rate_hz
        for index in range(1, samples + 1):
            ratio = index / samples
            blend = _minimum_jerk(ratio)
            elapsed += 1.0 / rate_hz
            times.append(round(elapsed, 9))
            positions.append(
                tuple(float(value) for value in start + blend * delta)
            )
    return tuple(times), tuple(positions)


def sample_waypoints_fixed_duration(
    waypoints: list[np.ndarray],
    duration_s: float,
    *,
    rate_hz: float = 50.0,
) -> tuple[tuple[float, ...], tuple[tuple[float, ...], ...]]:
    """Sample a piecewise minimum-jerk path over one exact, aligned duration."""

    if len(waypoints) < 2:
        raise ValueError("at least two waypoints are required")
    if duration_s <= 0.0 or rate_hz <= 0.0:
        raise ValueError("duration_s and rate_hz must be positive")
    ticks = int(round(duration_s * rate_hz))
    if ticks < len(waypoints) - 1:
        raise ValueError("duration is too short to sample every waypoint segment")
    aligned_duration = ticks / rate_hz
    if abs(aligned_duration - duration_s) > 1e-9:
        raise ValueError(
            f"duration_s must align to the {rate_hz:.1f} Hz command period"
        )
    segment_weights = np.asarray(
        [
            max(float(np.max(np.abs(goal - start))), 1e-9)
            for start, goal in zip(waypoints, waypoints[1:])
        ],
        dtype=float,
    )
    cumulative = np.concatenate(([0.0], np.cumsum(segment_weights)))
    total = float(cumulative[-1])
    times = []
    positions = []
    for tick in range(ticks + 1):
        time_s = tick / rate_hz
        progress = total * tick / ticks
        segment = min(
            len(segment_weights) - 1,
            max(0, int(np.searchsorted(cumulative, progress, side="right") - 1)),
        )
        local = (progress - cumulative[segment]) / segment_weights[segment]
        blend = _minimum_jerk(max(0.0, min(1.0, float(local))))
        position = waypoints[segment] + blend * (
            waypoints[segment + 1] - waypoints[segment]
        )
        times.append(round(time_s, 9))
        positions.append(tuple(float(value) for value in position))
    positions[0] = tuple(float(value) for value in waypoints[0])
    positions[-1] = tuple(float(value) for value in waypoints[-1])
    return tuple(times), tuple(positions)


def measured_maximum_velocity(
    times: Iterable[float], positions: Iterable[Iterable[float]]
) -> float:
    time_values = tuple(times)
    position_values = tuple(tuple(row) for row in positions)
    maximum = 0.0
    for index in range(1, len(time_values)):
        dt = time_values[index] - time_values[index - 1]
        maximum = max(
            maximum,
            max(
                abs(current - previous) / dt
                for previous, current in zip(
                    position_values[index - 1], position_values[index]
                )
            ),
        )
    return maximum


def _default_target(ik: OfficialIK, side: str, ready: list[float]) -> tuple[float, float, float]:
    current = np.asarray(ik.fk_world(side, ready), dtype=float)
    lateral = 0.035 if side == "right" else -0.035
    return tuple(float(value) for value in current + (0.055, lateral, 0.025))


def plan_trajectory(
    profile: RobotProfile,
    *,
    side: str = "right",
    target_world_xyz: Iterable[float] | None = None,
    vision_result: Path | None = None,
    robot_urdf: Path | None = None,
    table_clearance_m: float = 0.025,
    approach_distance_m: float = 0.075,
    random_seed: int = 11,
) -> PlannedTrajectory:
    """Plan and densely verify one approach trajectory in MuJoCo."""
    started = time.monotonic()
    if side not in AVAILABLE_GRIPPER_SIDES:
        raise ValueError(
            "grasp side must be right because the competition robot has no "
            "left OmniPicker"
        )
    if not 0.0 <= table_clearance_m <= 0.10:
        raise ValueError("table_clearance_m must be within [0, 0.10]")
    if not 0.01 <= approach_distance_m <= 0.30:
        raise ValueError("approach_distance_m must be within [0.01, 0.30]")

    obstacle: TableObstacle | None = None
    vision_target: tuple[float, float, float] | None = None
    if vision_result is not None:
        vision_target, obstacle = load_table_obstacle(vision_result)
    visual_urdf_path = resolve_robot_visual_urdf(robot_urdf)
    ik = OfficialIK(profile)
    start_arm_pos = profile.mc_start_arm_pos()
    target = tuple(
        float(value)
        for value in (
            target_world_xyz
            if target_world_xyz is not None
            else vision_target
            if vision_target is not None
            else _default_target(ik, side, start_arm_pos)
        )
    )
    if len(target) != 3 or not all(math.isfinite(value) for value in target):
        raise ValueError("target_world_xyz must contain three finite values")
    side_grasp = obstacle is not None and obstacle.target_object is not None
    if side_grasp and target_world_xyz is None:
        # Segmentation commonly returns the visible top surface.  A horizontal
        # side grasp must instead close around the object's modeled mid-height.
        target = obstacle.target_object.gripper_center_m
    approach_normal = np.asarray(
        obstacle.plane_normal if obstacle is not None else (0.0, 0.0, 1.0),
        dtype=float,
    )
    pregrasp = tuple(
        float(value)
        for value in np.asarray(target, dtype=float)
        + approach_distance_m * approach_normal
    )
    grasp_axis_world: np.ndarray | None = None
    opening_axis_world: np.ndarray | None = None
    target_rpy_world: tuple[float, float, float] | None = None
    if side_grasp:
        heading = math.radians(SIDE_GRASP_APPROACH_HEADING_DEG)
        preferred_approach = np.asarray(
            (math.cos(heading), math.sin(heading), 0.0), dtype=float
        )
        side_approach_axis_world = preferred_approach - float(
            np.dot(preferred_approach, approach_normal)
        ) * approach_normal
        if float(np.linalg.norm(side_approach_axis_world)) < 1e-9:
            side_approach_axis_world = np.asarray((1.0, 0.0, 0.0), dtype=float)
            side_approach_axis_world -= float(
                np.dot(side_approach_axis_world, approach_normal)
            ) * approach_normal
        side_approach_axis_world /= float(np.linalg.norm(side_approach_axis_world))
        local_x_world = approach_normal
        opening_axis_world = np.cross(side_approach_axis_world, local_x_world)
        opening_axis_world /= float(np.linalg.norm(opening_axis_world))
        target_rotation_world = np.column_stack(
            (local_x_world, opening_axis_world, side_approach_axis_world)
        )
        target_rpy_world = _rotation_matrix_to_rpy(target_rotation_world)
        grasp_axis_world = side_approach_axis_world

    alignment = validate_fk_alignment(profile, ik, random_samples=4, seed=random_seed)
    if alignment.maximum_position_error_m > 1e-3:
        raise RuntimeError(
            f"SDK/MuJoCo FK position mismatch: {alignment.maximum_position_error_m:.6g} m"
        )
    if alignment.maximum_orientation_error_deg > 0.5:
        raise RuntimeError(
            "SDK/MuJoCo FK orientation mismatch: "
            f"{alignment.maximum_orientation_error_deg:.6g} deg"
        )

    simulation = RobotSimulation(
        profile,
        ik,
        obstacle,
        visual_urdf_path=visual_urdf_path,
    )
    checker = CollisionChecker(
        simulation,
        side,
        start_arm_pos,
        table_clearance_m if obstacle is not None else 0.0,
        edge_resolution_rad=0.01,
    )
    rng = np.random.default_rng(random_seed)
    offset = 0 if side == "left" else profile.arm_dof
    start_joints = np.asarray(
        start_arm_pos[offset:offset + profile.arm_dof], dtype=float
    )

    pregrasp_result = solve_collision_free_ik(
        ik,
        checker,
        side,
        pregrasp,
        start_arm_pos,
        rng,
        target_axis_world=grasp_axis_world,
        target_rpy_world=target_rpy_world,
    )
    pregrasp_joints = np.asarray(pregrasp_result.active_arm, dtype=float)
    lower, upper = ik.joint_limits_for_side(side)
    path, rrt_report = plan_rrt(
        start_joints,
        pregrasp_joints,
        checker,
        lower,
        upper,
        rng,
    )
    transit_path = shortcut_path(path, checker, rng)

    approach_segments = max(4, int(math.ceil(approach_distance_m / 0.015)))
    previous_joints = pregrasp_joints
    previous_arm_pos = pregrasp_result.arm_pos
    final_result = pregrasp_result
    descent_path = [pregrasp_joints.copy()]
    for index in range(1, approach_segments + 1):
        ratio = index / approach_segments
        cartesian_target = (
            np.asarray(pregrasp, dtype=float)
            + ratio * (np.asarray(target, dtype=float) - np.asarray(pregrasp, dtype=float))
        )
        final_result = solve_collision_free_ik(
            ik,
            checker,
            side,
            cartesian_target,
            previous_arm_pos,
            rng,
            attempts=8,
            required_edge_start=previous_joints,
            target_axis_world=grasp_axis_world,
            target_rpy_world=target_rpy_world,
        )
        previous_joints = np.asarray(final_result.active_arm, dtype=float)
        previous_arm_pos = final_result.arm_pos
        descent_path.append(previous_joints.copy())

    transit_times, transit_positions = sample_waypoints(
        transit_path, profile.maximum_velocity_rad_s
    )
    descent_times, descent_positions = sample_waypoints(
        descent_path, profile.maximum_velocity_rad_s
    )
    descent_start_time_s = transit_times[-1]
    times = transit_times + tuple(
        round(descent_start_time_s + value, 9) for value in descent_times[1:]
    )
    positions = transit_positions + descent_positions[1:]
    maximum_velocity = measured_maximum_velocity(times, positions)
    if maximum_velocity > profile.maximum_velocity_rad_s + 1e-6:
        raise RuntimeError(
            f"sampled trajectory velocity {maximum_velocity:.6g} exceeds profile limit"
        )
    verification_checker = CollisionChecker(
        simulation,
        side,
        start_arm_pos,
        table_clearance_m if obstacle is not None else 0.0,
        edge_resolution_rad=0.01,
    )
    approach_axis_table_tilts_deg: list[float] = []
    opening_tilts_deg: list[float] = []
    descent_start_frame = len(transit_times) - 1
    for frame_index, position in enumerate(positions):
        if not verification_checker.state_valid(position):
            raise RuntimeError(
                "densely sampled trajectory is in collision: "
                f"{verification_checker.last_invalid_report}"
            )
        if side_grasp and frame_index >= descent_start_frame:
            rotation = simulation.site_world_rotation(side)
            tcp_axis = rotation[:, 2]
            approach_normal_component = float(np.clip(
                abs(np.dot(tcp_axis, approach_normal)), 0.0, 1.0
            ))
            approach_axis_table_tilts_deg.append(
                math.degrees(math.asin(approach_normal_component))
            )
            opening_axis = rotation[:, 1]
            normal_component = float(np.clip(
                abs(np.dot(opening_axis, approach_normal)), 0.0, 1.0
            ))
            opening_tilts_deg.append(math.degrees(math.asin(normal_component)))
    maximum_approach_axis_table_tilt = (
        max(approach_axis_table_tilts_deg) if side_grasp else None
    )
    maximum_opening_tilt = max(opening_tilts_deg) if side_grasp else None
    if (
        maximum_approach_axis_table_tilt is not None
        and maximum_approach_axis_table_tilt > MAXIMUM_GRIPPER_AXIS_ERROR_DEG
    ):
        raise RuntimeError(
            "gripper finger direction is not parallel to the table: "
            f"maximum tilt={maximum_approach_axis_table_tilt:.3f} deg"
        )
    if (
        maximum_opening_tilt is not None
        and maximum_opening_tilt > MAXIMUM_GRIPPER_AXIS_ERROR_DEG
    ):
        raise RuntimeError(
            "gripper opening direction is not parallel to the table: "
            f"maximum tilt={maximum_opening_tilt:.3f} deg"
        )

    final_error = float(
        np.linalg.norm(
            np.asarray(final_result.final_world_xyz) - np.asarray(target)
        )
    )
    if final_error > 1e-3:
        raise RuntimeError(f"final position error {final_error:.6g} m exceeds 1 mm")
    report: dict[str, object] = {
        "verified_collision_free": True,
        "trajectory_role": "approach",
        "robot_profile": profile.name,
        "arm_side": side,
        "installed_gripper_side": INSTALLED_GRIPPER_SIDE,
        "ik_backend": "x2_ik_sdk.X2ArmIKSolver",
        "kinematic_urdf": str(ik.urdf_path),
        "tool_pose_calibration": str(ik.tool_pose.source_path),
        "active_tcp_offset": {
            "parent_frame": ik.tool_pose.for_side(side).parent_frame,
            "translation_m": list(ik.tool_pose.for_side(side).translation_m),
            "rpy_rad": list(ik.tool_pose.for_side(side).rpy_rad),
        },
        "robot_visual_urdf": (
            str(visual_urdf_path) if visual_urdf_path is not None else None
        ),
        "omnipicker_visual_description": (
            str(simulation.omnipicker_description_path)
            if simulation.omnipicker_description_path is not None
            else None
        ),
        "start_pose": "mc_animation_default",
        "object_center_world_m": (
            list(obstacle.target_object.object_center_m)
            if side_grasp and obstacle is not None
            else None
        ),
        "gripper_center_world_m": list(target),
        "target_world_m": list(target),
        "pregrasp_world_m": list(pregrasp),
        "grasp_mode": "horizontal_side_grasp" if side_grasp else "position_only",
        "gripper_side_approach_local_axis": "+Z" if side_grasp else None,
        "grasp_axis_world": (
            [float(value) for value in grasp_axis_world]
            if grasp_axis_world is not None
            else None
        ),
        "maximum_side_approach_table_tilt_deg": maximum_approach_axis_table_tilt,
        "gripper_opening_local_axis": "+Y" if side_grasp else None,
        "gripper_opening_axis_world": (
            [float(value) for value in opening_axis_world]
            if opening_axis_world is not None
            else None
        ),
        "target_rpy_world_rad": (
            [float(value) for value in target_rpy_world]
            if target_rpy_world is not None
            else None
        ),
        "maximum_opening_direction_table_tilt_deg": maximum_opening_tilt,
        "final_position_error_m": final_error,
        "table_clearance_m": table_clearance_m if obstacle is not None else None,
        "minimum_observed_table_distance_m": (
            verification_checker.minimum_table_distance_m
            if obstacle is not None
            else None
        ),
        "nearest_table_body": verification_checker.nearest_table_body,
        "state_checks": checker.state_checks + verification_checker.state_checks,
        "rrt": {
            **rrt_report,
            "shortcut_waypoints": len(transit_path),
        },
        "approach_segments": approach_segments,
        "vertical_descent_start_time_s": descent_start_time_s,
        "vertical_descent_start_frame": descent_start_frame,
        "vertical_descent_distance_m": approach_distance_m,
        "frame_count": len(times),
        "duration_s": times[-1],
        "maximum_velocity_rad_s": maximum_velocity,
        "fk_alignment": {
            "samples": alignment.samples,
            "maximum_position_error_m": alignment.maximum_position_error_m,
            "maximum_orientation_error_deg": alignment.maximum_orientation_error_deg,
        },
        "vision_result": str(vision_result.resolve()) if vision_result else None,
        "table_obstacle": (
            {
                "center_m": list(obstacle.center_m),
                "quaternion_wxyz": list(obstacle.quaternion_wxyz),
                "half_extents_m": list(obstacle.half_extents_m),
                "plane_normal": list(obstacle.plane_normal),
            }
            if obstacle is not None
            else None
        ),
        "planning_time_s": time.monotonic() - started,
    }
    return PlannedTrajectory(
        profile=profile,
        side=side,
        obstacle=obstacle,
        visual_urdf_path=visual_urdf_path,
        target_world_xyz=target,
        pregrasp_world_xyz=pregrasp,
        joint_names=profile.joints_for_side(side),
        times=times,
        positions=positions,
        report=report,
    )


def plan_lift_trajectory(
    approach: PlannedTrajectory,
    *,
    lift_height_m: float = 0.045,
    lift_duration_s: float = 2.0,
    random_seed: int = 23,
) -> PlannedTrajectory:
    """Plan a collision-checked Cartesian lift from an approach endpoint."""

    if approach.side not in AVAILABLE_GRIPPER_SIDES:
        raise ValueError(
            "lift side must be right because the competition robot has no "
            "left OmniPicker"
        )
    if not 0.03 <= lift_height_m <= 0.30:
        raise ValueError("lift_height_m must be within [0.03, 0.30]")
    if not 0.5 <= lift_duration_s <= 10.0:
        raise ValueError("lift_duration_s must be within [0.5, 10.0]")
    profile = approach.profile
    started = time.monotonic()
    ik = OfficialIK(profile)
    simulation = RobotSimulation(
        profile,
        ik,
        approach.obstacle,
        visual_urdf_path=approach.visual_urdf_path,
    )
    table_clearance = approach.report.get("table_clearance_m")
    checker = CollisionChecker(
        simulation,
        approach.side,
        profile.mc_start_arm_pos(),
        float(table_clearance) if table_clearance is not None else 0.0,
        edge_resolution_rad=0.01,
    )
    direction = np.asarray(
        (
            approach.obstacle.plane_normal
            if approach.obstacle is not None
            else (0.0, 0.0, 1.0)
        ),
        dtype=float,
    )
    direction /= float(np.linalg.norm(direction))
    if direction[2] < 0.0:
        direction *= -1.0
    side_grasp = approach.report.get("grasp_mode") == "horizontal_side_grasp"
    configured_axis = approach.report.get("grasp_axis_world")
    grasp_axis_world: np.ndarray | None = None
    if side_grasp:
        grasp_axis_world = np.asarray(configured_axis, dtype=float)
        if grasp_axis_world.shape != (3,) or not np.all(np.isfinite(grasp_axis_world)):
            raise ValueError("approach grasp_axis_world is invalid")
        grasp_axis_world /= float(np.linalg.norm(grasp_axis_world))
    configured_rpy = approach.report.get("target_rpy_world_rad")
    target_rpy_world = (
        tuple(float(value) for value in configured_rpy)
        if isinstance(configured_rpy, list) and len(configured_rpy) == 3
        else None
    )
    start_target = np.asarray(approach.target_world_xyz, dtype=float)
    lifted_target = start_target + lift_height_m * direction
    start_joints = np.asarray(approach.positions[-1], dtype=float)
    if not checker.state_valid(start_joints):
        raise RuntimeError(
            "approach endpoint is invalid for lift planning: "
            f"{checker.last_invalid_report}"
        )
    preferred_arm_pos = checker.arm_pos_for(start_joints)
    previous_joints = start_joints
    path = [start_joints.copy()]
    rng = np.random.default_rng(random_seed)
    segments = max(4, int(math.ceil(lift_height_m / 0.015)))
    final_result: WorldIKResult | None = None
    for index in range(1, segments + 1):
        target = start_target + (index / segments) * lift_height_m * direction
        final_result = solve_collision_free_ik(
            ik,
            checker,
            approach.side,
            target,
            preferred_arm_pos,
            rng,
            attempts=10,
            required_edge_start=previous_joints,
            target_axis_world=grasp_axis_world,
            target_rpy_world=target_rpy_world,
        )
        previous_joints = np.asarray(final_result.active_arm, dtype=float)
        preferred_arm_pos = final_result.arm_pos
        path.append(previous_joints.copy())
    assert final_result is not None

    times, positions = sample_waypoints_fixed_duration(
        path,
        lift_duration_s,
    )
    maximum_velocity = measured_maximum_velocity(times, positions)
    if maximum_velocity > profile.maximum_velocity_rad_s + 1e-6:
        raise RuntimeError(
            f"requested lift requires {maximum_velocity:.3f} rad/s, above "
            f"the {profile.maximum_velocity_rad_s:.3f} rad/s profile limit"
        )
    verification = CollisionChecker(
        simulation,
        approach.side,
        profile.mc_start_arm_pos(),
        float(table_clearance) if table_clearance is not None else 0.0,
        edge_resolution_rad=0.01,
    )
    maximum_approach_axis_table_tilt: float | None = None
    maximum_opening_tilt: float | None = None
    for previous, current in zip(positions, positions[1:]):
        if not verification.edge_valid(previous, current):
            raise RuntimeError(
                "densely sampled lift trajectory is in collision: "
                f"{verification.last_invalid_report}"
            )
        simulation.set_side_joints(
            approach.side,
            current,
            profile.mc_start_arm_pos(),
        )
        if side_grasp:
            rotation = simulation.site_world_rotation(approach.side)
            tcp_axis = rotation[:, 2]
            normal_component = float(np.clip(
                abs(np.dot(tcp_axis, direction)), 0.0, 1.0
            ))
            approach_tilt = math.degrees(math.asin(normal_component))
            maximum_approach_axis_table_tilt = max(
                maximum_approach_axis_table_tilt or 0.0,
                approach_tilt,
            )
            opening_axis = rotation[:, 1]
            normal_component = float(np.clip(
                abs(np.dot(opening_axis, direction)), 0.0, 1.0
            ))
            opening_tilt = math.degrees(math.asin(normal_component))
            maximum_opening_tilt = max(
                maximum_opening_tilt or 0.0,
                opening_tilt,
            )
    if (
        maximum_approach_axis_table_tilt is not None
        and maximum_approach_axis_table_tilt > MAXIMUM_GRIPPER_AXIS_ERROR_DEG
    ):
        raise RuntimeError(
            "gripper finger direction is not parallel to the table during lift: "
            f"maximum tilt={maximum_approach_axis_table_tilt:.3f} deg"
        )
    if (
        maximum_opening_tilt is not None
        and maximum_opening_tilt > MAXIMUM_GRIPPER_AXIS_ERROR_DEG
    ):
        raise RuntimeError(
            "gripper opening direction is not parallel to the table during lift: "
            f"maximum tilt={maximum_opening_tilt:.3f} deg"
        )
    final_error = float(
        np.linalg.norm(
            np.asarray(final_result.final_world_xyz) - lifted_target
        )
    )
    if final_error > 1e-3:
        raise RuntimeError(f"lift final position error {final_error:.6g} m exceeds 1 mm")
    target_object = (
        approach.obstacle.target_object
        if approach.obstacle is not None
        else None
    )
    object_center_start = (
        np.asarray(target_object.object_center_m, dtype=float)
        if target_object is not None
        else None
    )
    object_center_lifted = (
        object_center_start + lift_height_m * direction
        if object_center_start is not None
        else None
    )
    report: dict[str, object] = {
        "verified_collision_free": True,
        "trajectory_role": "lift",
        "robot_profile": profile.name,
        "arm_side": approach.side,
        "installed_gripper_side": INSTALLED_GRIPPER_SIDE,
        "ik_backend": "x2_ik_sdk.X2ArmIKSolver",
        "kinematic_urdf": str(ik.urdf_path),
        "tool_pose_calibration": str(ik.tool_pose.source_path),
        "robot_visual_urdf": (
            str(approach.visual_urdf_path)
            if approach.visual_urdf_path is not None
            else None
        ),
        "omnipicker_visual_description": (
            str(simulation.omnipicker_description_path)
            if simulation.omnipicker_description_path is not None
            else None
        ),
        "start_pose": "grasp_endpoint",
        "lift_start_object_center_world_m": (
            [float(value) for value in object_center_start]
            if object_center_start is not None
            else None
        ),
        "object_center_world_m": (
            [float(value) for value in object_center_lifted]
            if object_center_lifted is not None
            else None
        ),
        "lift_start_gripper_center_world_m": list(approach.target_world_xyz),
        "gripper_center_world_m": [float(value) for value in lifted_target],
        "lift_start_world_m": list(approach.target_world_xyz),
        "target_world_m": [float(value) for value in lifted_target],
        "lift_direction_world": [float(value) for value in direction],
        "grasp_axis_world": (
            [float(value) for value in grasp_axis_world]
            if grasp_axis_world is not None
            else None
        ),
        "maximum_side_approach_table_tilt_deg": maximum_approach_axis_table_tilt,
        "maximum_opening_direction_table_tilt_deg": maximum_opening_tilt,
        "lift_height_m": lift_height_m,
        "lift_duration_s": times[-1],
        "final_position_error_m": final_error,
        "table_clearance_m": table_clearance,
        "minimum_observed_table_distance_m": (
            verification.minimum_table_distance_m
            if approach.obstacle is not None
            else None
        ),
        "nearest_table_body": verification.nearest_table_body,
        "state_checks": checker.state_checks + verification.state_checks,
        "cartesian_segments": segments,
        "frame_count": len(times),
        "duration_s": times[-1],
        "maximum_velocity_rad_s": maximum_velocity,
        "source_approach_vision_result": approach.report.get("vision_result"),
        "planning_time_s": time.monotonic() - started,
    }
    return PlannedTrajectory(
        profile=profile,
        side=approach.side,
        obstacle=approach.obstacle,
        visual_urdf_path=approach.visual_urdf_path,
        target_world_xyz=tuple(float(value) for value in lifted_target),
        pregrasp_world_xyz=approach.target_world_xyz,
        joint_names=approach.joint_names,
        times=times,
        positions=positions,
        report=report,
    )


def plan_return_to_default_trajectory(
    lift: PlannedTrajectory,
    *,
    random_seed: int = 37,
) -> PlannedTrajectory:
    """Plan a collision-checked path from the lifted pose to the MC default pose."""

    profile = lift.profile
    started = time.monotonic()
    ik = OfficialIK(profile)
    simulation = RobotSimulation(
        profile,
        ik,
        lift.obstacle,
        visual_urdf_path=lift.visual_urdf_path,
    )
    base_arm_pos = profile.mc_start_arm_pos()
    table_clearance = lift.report.get("table_clearance_m")
    checker = CollisionChecker(
        simulation,
        lift.side,
        base_arm_pos,
        float(table_clearance) if table_clearance is not None else 0.0,
        edge_resolution_rad=0.01,
    )
    offset = 0 if lift.side == "left" else profile.arm_dof
    start = np.asarray(lift.positions[-1], dtype=float)
    goal = np.asarray(
        base_arm_pos[offset:offset + profile.arm_dof], dtype=float
    )
    lower, upper = ik.joint_limits_for_side(lift.side)
    rng = np.random.default_rng(random_seed)
    path, rrt_report = plan_rrt(
        start,
        goal,
        checker,
        lower,
        upper,
        rng,
    )
    path = shortcut_path(path, checker, rng)
    times, positions = sample_waypoints(path, profile.maximum_velocity_rad_s)
    maximum_velocity = measured_maximum_velocity(times, positions)
    if maximum_velocity > profile.maximum_velocity_rad_s + 1e-6:
        raise RuntimeError(
            f"return trajectory velocity {maximum_velocity:.6g} exceeds profile limit"
        )
    verification = CollisionChecker(
        simulation,
        lift.side,
        base_arm_pos,
        float(table_clearance) if table_clearance is not None else 0.0,
        edge_resolution_rad=0.01,
    )
    for previous, current in zip(positions, positions[1:]):
        if not verification.edge_valid(previous, current):
            raise RuntimeError(
                "densely sampled return trajectory is in collision: "
                f"{verification.last_invalid_report}"
            )
    final_arm_pos = checker.arm_pos_for(goal)
    final_world = ik.fk_world(lift.side, final_arm_pos)
    report: dict[str, object] = {
        "verified_collision_free": True,
        "trajectory_role": "return_to_default",
        "robot_profile": profile.name,
        "arm_side": lift.side,
        "installed_gripper_side": INSTALLED_GRIPPER_SIDE,
        "ik_backend": "x2_ik_sdk.X2ArmIKSolver",
        "kinematic_urdf": str(ik.urdf_path),
        "tool_pose_calibration": str(ik.tool_pose.source_path),
        "robot_visual_urdf": (
            str(lift.visual_urdf_path)
            if lift.visual_urdf_path is not None
            else None
        ),
        "start_pose": "lift_endpoint",
        "target_pose": "mc_animation_default",
        "target_world_m": [float(value) for value in final_world],
        "table_clearance_m": table_clearance,
        "minimum_observed_table_distance_m": (
            verification.minimum_table_distance_m
            if lift.obstacle is not None
            else None
        ),
        "nearest_table_body": verification.nearest_table_body,
        "state_checks": checker.state_checks + verification.state_checks,
        "rrt": {**rrt_report, "shortcut_waypoints": len(path)},
        "frame_count": len(times),
        "duration_s": times[-1],
        "maximum_velocity_rad_s": maximum_velocity,
        "planning_time_s": time.monotonic() - started,
    }
    return PlannedTrajectory(
        profile=profile,
        side=lift.side,
        obstacle=lift.obstacle,
        visual_urdf_path=lift.visual_urdf_path,
        target_world_xyz=tuple(float(value) for value in final_world),
        pregrasp_world_xyz=lift.target_world_xyz,
        joint_names=lift.joint_names,
        times=times,
        positions=positions,
        report=report,
    )


def plan_simulated_grasp_sequence(
    approach: PlannedTrajectory,
    *,
    lift_height_m: float = 0.045,
    lift_duration_s: float = 2.5,
) -> SimulatedGraspSequence:
    """Build the complete right-hand grasp, release and reset simulation."""

    target_object = (
        approach.obstacle.target_object
        if approach.obstacle is not None
        else None
    )
    if target_object is None:
        raise ValueError(
            "complete grasp simulation requires selected_detection object geometry"
        )
    if "vertical_descent_start_time_s" not in approach.report:
        raise ValueError("approach trajectory has no vertical descent phase boundary")
    preopen, grip = gripper_positions_for_visual_radius(
        target_object.visual_radius_m
    )
    lift = plan_lift_trajectory(
        approach,
        lift_height_m=lift_height_m,
        lift_duration_s=lift_duration_s,
    )
    return_to_default = plan_return_to_default_trajectory(lift)
    simulation = RobotSimulation(
        approach.profile,
        OfficialIK(approach.profile),
        approach.obstacle,
        visual_urdf_path=approach.visual_urdf_path,
    )
    base_arm_pos = approach.profile.mc_start_arm_pos()
    clearance_value = approach.report.get("table_clearance_m")
    clearance = float(clearance_value) if clearance_value is not None else 0.0
    checks = 0
    minimum_table_distance = simulation.probe_distance_m

    def validate_state(joints: Iterable[float], gripper: float, phase: str) -> None:
        nonlocal checks, minimum_table_distance
        simulation.set_side_joints(approach.side, joints, base_arm_pos)
        simulation.set_gripper_position(gripper)
        state = simulation.collision_report(clearance)
        checks += 1
        minimum_table_distance = min(
            minimum_table_distance, state.minimum_table_distance_m
        )
        if not state.valid:
            raise RuntimeError(
                f"simulated grasp phase {phase!r} is in collision: {state}"
            )

    descent_frame = int(approach.report["vertical_descent_start_frame"])
    for gripper in np.linspace(0.0, preopen, 11):
        validate_state(approach.positions[descent_frame], float(gripper), "open")
    for joints in approach.positions[descent_frame:]:
        validate_state(joints, preopen, "vertical_descent")
    for gripper in np.linspace(preopen, grip, 11):
        validate_state(approach.positions[-1], float(gripper), "radius_close")
    for joints in lift.positions:
        validate_state(joints, grip, "vertical_lift")
    for gripper in np.linspace(grip, 1.0, 11):
        validate_state(lift.positions[-1], float(gripper), "release")
    report: dict[str, object] = {
        "verified_collision_free": True,
        "trajectory_role": "simulated_grasp_sequence",
        "visual_radius_m": target_object.visual_radius_m,
        "estimated_object_diameter_m": 2.0 * target_object.visual_radius_m,
        "omnipicker_maximum_diameter_m": OMNIPICKER_MAX_GRASP_DIAMETER_M,
        "preopen_position": preopen,
        "grip_position": grip,
        "vertical_descent_start_time_s": float(
            approach.report["vertical_descent_start_time_s"]
        ),
        "open_duration_s": GRIPPER_PREOPEN_DURATION_S,
        "close_duration_s": GRIPPER_CLOSE_DURATION_S,
        "grasp_settle_duration_s": GRASP_SETTLE_DURATION_S,
        "lift_duration_s": lift.duration_s,
        "release_duration_s": GRIPPER_RELEASE_DURATION_S,
        "object_drop_duration_s": OBJECT_DROP_DURATION_S,
        "reclose_duration_s": GRIPPER_RECLOSE_DURATION_S,
        "maximum_descent_side_approach_table_tilt_deg": approach.report[
            "maximum_side_approach_table_tilt_deg"
        ],
        "maximum_descent_opening_table_tilt_deg": approach.report[
            "maximum_opening_direction_table_tilt_deg"
        ],
        "maximum_lift_side_approach_table_tilt_deg": lift.report[
            "maximum_side_approach_table_tilt_deg"
        ],
        "maximum_lift_opening_table_tilt_deg": lift.report[
            "maximum_opening_direction_table_tilt_deg"
        ],
        "return_duration_s": return_to_default.duration_s,
        "total_duration_s": round(
            approach.duration_s
            + GRIPPER_PREOPEN_DURATION_S
            + GRIPPER_CLOSE_DURATION_S
            + GRASP_SETTLE_DURATION_S
            + lift.duration_s
            + GRIPPER_RELEASE_DURATION_S
            + OBJECT_DROP_DURATION_S
            + GRIPPER_RECLOSE_DURATION_S
            + return_to_default.duration_s,
            9,
        ),
        "phases": [
            "move_above_object",
            "open_for_visual_radius",
            "vertical_descent",
            "close_to_visual_radius",
            "grasp_settle",
            "vertical_lift",
            "fully_open_release",
            "object_drop_to_table",
            "close_empty_gripper",
            "return_to_default",
        ],
        "collision_state_checks": checks,
        "minimum_observed_table_distance_m": minimum_table_distance,
    }
    return SimulatedGraspSequence(
        approach=approach,
        lift=lift,
        return_to_default=return_to_default,
        visual_radius_m=target_object.visual_radius_m,
        preopen_position=preopen,
        grip_position=grip,
        report=report,
    )


def _interpolate_replay_position(
    trajectory: PlannedTrajectory,
    elapsed_s: float,
) -> tuple[float, ...]:
    """Sample a verified trajectory at wall-clock time for responsive display."""

    if elapsed_s <= trajectory.times[0]:
        return trajectory.positions[0]
    if elapsed_s >= trajectory.times[-1]:
        return trajectory.positions[-1]
    right = bisect_right(trajectory.times, elapsed_s)
    left = right - 1
    span = trajectory.times[right] - trajectory.times[left]
    ratio = (elapsed_s - trajectory.times[left]) / span
    return tuple(
        float(start + ratio * (end - start))
        for start, end in zip(
            trajectory.positions[left],
            trajectory.positions[right],
        )
    )


def replay_viewer(trajectory: PlannedTrajectory) -> None:
    """Replay a verified trajectory in the MuJoCo passive viewer."""
    try:
        from mujoco import viewer
    except ImportError as error:
        raise RuntimeError(f"MuJoCo viewer is unavailable: {error}") from error
    ik = OfficialIK(trajectory.profile)
    simulation = RobotSimulation(
        trajectory.profile,
        ik,
        trajectory.obstacle,
        visual_urdf_path=trajectory.visual_urdf_path,
    )
    start_arm_pos = trajectory.profile.mc_start_arm_pos()
    threads_before = set(threading.enumerate())
    window = viewer.launch_passive(simulation.model, simulation.data)
    viewer_threads = set(threading.enumerate()) - threads_before
    try:
        window.cam.lookat[:] = (0.25, 0.0, 0.75)
        window.cam.distance = 2.15
        window.cam.azimuth = 200.0
        window.cam.elevation = -20.0
        playback_started = time.monotonic()
        refresh_period_s = 1.0 / 30.0
        while window.is_running():
            frame_started = time.monotonic()
            elapsed_s = min(
                frame_started - playback_started,
                trajectory.duration_s,
            )
            position = _interpolate_replay_position(trajectory, elapsed_s)
            simulation.set_side_joints(trajectory.side, position, start_arm_pos)
            window.sync()
            if elapsed_s >= trajectory.duration_s:
                break
            remaining_s = refresh_period_s - (time.monotonic() - frame_started)
            if remaining_s > 0.0:
                time.sleep(remaining_s)
    finally:
        window.close()
        # launch_passive uses a daemon UI thread on Linux.  Waiting for its
        # GLFW/X11 teardown prevents the interpreter from unloading native
        # libraries underneath that thread and crashing on process exit.
        for thread in viewer_threads:
            thread.join(timeout=5.0)
        still_running = [thread.name for thread in viewer_threads if thread.is_alive()]
        if still_running:
            raise RuntimeError(
                "MuJoCo Viewer did not shut down cleanly: " + ", ".join(still_running)
            )


def replay_grasp_sequence(sequence: SimulatedGraspSequence) -> None:
    """Replay arm, right OmniPicker and target-object motion as one state machine."""

    try:
        from mujoco import viewer
    except ImportError as error:
        raise RuntimeError(f"MuJoCo viewer is unavailable: {error}") from error
    approach = sequence.approach
    target_object = (
        approach.obstacle.target_object
        if approach.obstacle is not None
        else None
    )
    if target_object is None:
        raise RuntimeError("grasp sequence has no target object")
    ik = OfficialIK(approach.profile)
    simulation = RobotSimulation(
        approach.profile,
        ik,
        approach.obstacle,
        visual_urdf_path=approach.visual_urdf_path,
    )
    start_arm_pos = approach.profile.mc_start_arm_pos()
    descent_start = float(approach.report["vertical_descent_start_time_s"])
    descent_duration = approach.duration_s - descent_start
    phase_ends: list[tuple[str, float]] = []
    cursor = descent_start
    phase_ends.append(("move_above_object", cursor))
    cursor += sequence.open_duration_s
    phase_ends.append(("open_for_visual_radius", cursor))
    cursor += descent_duration
    phase_ends.append(("vertical_descent", cursor))
    cursor += sequence.close_duration_s
    phase_ends.append(("close_to_visual_radius", cursor))
    cursor += sequence.grasp_settle_duration_s
    phase_ends.append(("grasp_settle", cursor))
    cursor += sequence.lift.duration_s
    phase_ends.append(("vertical_lift", cursor))
    cursor += sequence.release_duration_s
    phase_ends.append(("fully_open_release", cursor))
    cursor += sequence.object_drop_duration_s
    phase_ends.append(("object_drop_to_table", cursor))
    cursor += sequence.reclose_duration_s
    phase_ends.append(("close_empty_gripper", cursor))
    cursor += sequence.return_to_default.duration_s
    phase_ends.append(("return_to_default", cursor))

    initial_center = np.asarray(target_object.object_center_m, dtype=float)
    initial_quaternion = target_object.quaternion_wxyz
    object_tcp_offset = initial_center - np.asarray(
        approach.target_world_xyz, dtype=float
    )
    lifted_center = initial_center + (
        np.asarray(sequence.lift.target_world_xyz, dtype=float)
        - np.asarray(approach.target_world_xyz, dtype=float)
    )

    threads_before = set(threading.enumerate())
    window = viewer.launch_passive(simulation.model, simulation.data)
    viewer_threads = set(threading.enumerate()) - threads_before
    last_phase: str | None = None
    try:
        window.cam.lookat[:] = (0.25, 0.0, 0.75)
        window.cam.distance = 2.15
        window.cam.azimuth = 200.0
        window.cam.elevation = -20.0
        playback_started = time.monotonic()
        refresh_period_s = 1.0 / 30.0
        while window.is_running():
            frame_started = time.monotonic()
            elapsed = min(frame_started - playback_started, cursor)
            phase_start = 0.0
            phase_name = phase_ends[-1][0]
            phase_end = cursor
            for candidate_name, candidate_end in phase_ends:
                if elapsed <= candidate_end:
                    phase_name = candidate_name
                    phase_end = candidate_end
                    break
                phase_start = candidate_end
            local_time = max(0.0, elapsed - phase_start)
            phase_duration = max(phase_end - phase_start, 1e-9)
            ratio = min(1.0, local_time / phase_duration)
            blend = _minimum_jerk(ratio)

            arm = approach.positions[0]
            gripper = 0.0
            object_center = initial_center
            attached = False
            if phase_name == "move_above_object":
                arm = _interpolate_replay_position(approach, elapsed)
            elif phase_name == "open_for_visual_radius":
                arm = _interpolate_replay_position(approach, descent_start)
                gripper = blend * sequence.preopen_position
            elif phase_name == "vertical_descent":
                arm = _interpolate_replay_position(
                    approach, descent_start + local_time
                )
                gripper = sequence.preopen_position
            elif phase_name == "close_to_visual_radius":
                arm = approach.positions[-1]
                gripper = sequence.preopen_position + blend * (
                    sequence.grip_position - sequence.preopen_position
                )
            elif phase_name == "grasp_settle":
                arm = approach.positions[-1]
                gripper = sequence.grip_position
                attached = True
            elif phase_name == "vertical_lift":
                arm = _interpolate_replay_position(sequence.lift, local_time)
                gripper = sequence.grip_position
                attached = True
            elif phase_name == "fully_open_release":
                arm = sequence.lift.positions[-1]
                gripper = sequence.grip_position + blend * (
                    1.0 - sequence.grip_position
                )
                attached = True
            elif phase_name == "object_drop_to_table":
                arm = sequence.lift.positions[-1]
                gripper = 1.0
                object_center = lifted_center + blend * (
                    initial_center - lifted_center
                )
            elif phase_name == "close_empty_gripper":
                arm = sequence.lift.positions[-1]
                gripper = 1.0 - blend
            elif phase_name == "return_to_default":
                arm = _interpolate_replay_position(
                    sequence.return_to_default, local_time
                )

            simulation.set_side_joints(approach.side, arm, start_arm_pos)
            simulation.set_gripper_position(gripper)
            if attached:
                object_center = (
                    np.asarray(simulation.site_world_xyz(approach.side), dtype=float)
                    + object_tcp_offset
                )
            simulation.set_target_object_pose(object_center, initial_quaternion)
            if phase_name != last_phase:
                print(f"MuJoCo phase: {phase_name}")
                last_phase = phase_name
            window.sync()
            if elapsed >= cursor:
                break
            remaining_s = refresh_period_s - (time.monotonic() - frame_started)
            if remaining_s > 0.0:
                time.sleep(remaining_s)
    finally:
        window.close()
        for thread in viewer_threads:
            thread.join(timeout=5.0)
        still_running = [thread.name for thread in viewer_threads if thread.is_alive()]
        if still_running:
            raise RuntimeError(
                "MuJoCo Viewer did not shut down cleanly: " + ", ".join(still_running)
            )


def preview_scene(
    profile: RobotProfile,
    *,
    vision_result: Path | None,
    robot_urdf: Path | None = None,
) -> None:
    """Open an interactive static scene when planning has no valid trajectory."""
    try:
        from mujoco import viewer
    except ImportError as error:
        raise RuntimeError(f"MuJoCo viewer is unavailable: {error}") from error
    obstacle = (
        load_table_obstacle(vision_result)[1]
        if vision_result is not None
        else None
    )
    ik = OfficialIK(profile)
    simulation = RobotSimulation(
        profile,
        ik,
        obstacle,
        visual_urdf_path=resolve_robot_visual_urdf(robot_urdf),
    )
    threads_before = set(threading.enumerate())
    window = viewer.launch_passive(simulation.model, simulation.data)
    viewer_threads = set(threading.enumerate()) - threads_before
    try:
        window.cam.lookat[:] = (0.25, 0.0, 0.75)
        window.cam.distance = 2.15
        window.cam.azimuth = 200.0
        window.cam.elevation = -20.0
        while window.is_running():
            window.sync()
            time.sleep(0.02)
    except KeyboardInterrupt:
        pass
    finally:
        window.close()
        for thread in viewer_threads:
            thread.join(timeout=5.0)
        still_running = [thread.name for thread in viewer_threads if thread.is_alive()]
        if still_running:
            raise RuntimeError(
                "MuJoCo Viewer did not shut down cleanly: " + ", ".join(still_running)
            )
